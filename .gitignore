# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# except the template — a fresh clone has no .env, and DATABASE_URL is not guessable
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
test-results/

/src/generated/prisma

# Leftover SQLite databases from before the move to Postgres. Nothing reads these now; the guard
# stays so a stray `.db` never gets committed. Same for the old E2E fixture directory — the suite
# uses a Postgres schema of its own these days.
*.db
*.db-journal
tests/e2e/.tmp/
