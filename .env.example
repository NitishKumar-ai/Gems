# Postgres. On Vercel the Neon Marketplace integration sets this for you; locally, point it at
# your own server and create the database once with `createdb gems_dev`.
#
# Apply the schema with `npx prisma migrate dev` (local) or `npx prisma migrate deploy` (deployed).
# `prisma/migrations/` is the source of truth now — `db push` skips it and loses schema history.
DATABASE_URL="postgresql://USER@localhost:5432/gems_dev?schema=public"

# NextAuth (GitHub provider). Generate a secret with: openssl rand -base64 32
#
# The OAuth app's callback URL must match the origin you run on:
#   http://localhost:3000/api/auth/callback/github   (local)
#   https://YOUR-DEPLOYMENT/api/auth/callback/github (deployed — needs its own OAuth app)
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
